+// CounterVecOpts bundles the options for creating a CounterVec with the v2 API.
+// It is essentially a superset of CounterOpts.
+type CounterVecOpts struct {
+	CounterOpts
+
+	// VariableLabels defines the partitioning of the counter vec by labels.
+	VariableLabels ConstrainedLabels
+}
+
+// NewCounterVec creates a new CounterVec based on the provided CounterVecOpts.
+// Note that variable labels can be constrained via ConstrainedLabels, and the
+// label values are then automatically validated.
+func NewCounterVec(opts CounterVecOpts) *CounterVec {
+	desc := NewDesc(
+		BuildFQName(opts.Namespace, opts.Subsystem, opts.Name),
+		opts.Help,
+		VariableLabelsFromConstrained(opts.VariableLabels),
+		opts.ConstLabels,
+	)
+	return &CounterVec{
+		MetricVec: NewMetricVec(desc, func(lvs ...string) Metric {
+			if len(lvs) != len(desc.variableLabels) {
+				panic(makeInconsistentCardinalityError(desc.fqName, desc.variableLabels, lvs))
+			}
+			result := &counter{desc: desc, labelPairs: MakeLabelPairs(desc, lvs), createdTs: time.Now()}
+			result.init(result)
+			return result
+		}),
+	}
+}
+
 type counter struct {
 	// valInt and valBits are both used to track the counter's value. Both
 	// fields must be first in the struct to guarantee 64-bit alignment on
@@ -55,6 +72,7 @@ type counter struct {
 	desc       *Desc
 	labelPairs []*dto.LabelPair
 	exemplar   atomic.Value
