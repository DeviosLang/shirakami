-func (c *counter) Write(out *dto.Metric) error {
+func (c *counter) Write(out *dto.Metric, createdTs *timestamppb.Timestamp) error {
 	val := math.Float64frombits(atomic.LoadUint64(&c.valBits))
 	var exemplar *dto.Exemplar
 	if e := c.exemplar.Load(); e != nil {
 		exemplar = e.(*dto.Exemplar)
 	}
-	return writeCounter(out, val, exemplar)
+	return writeCounter(out, val, exemplar, createdTs)
+}
+
+func (c *counter) createdTimestamp() *timestamppb.Timestamp {
+	if c.createdTs.IsZero() {
+		return nil
+	}
+	return timestamppb.New(c.createdTs)
 }
