+// ConstrainedLabels holds a list of labels and their optional value constraints.
+type ConstrainedLabel struct {
+	Name      string
+	Constraint func(string) string
+}
+
+// ConstrainedLabels is a slice of ConstrainedLabel.
+type ConstrainedLabels []ConstrainedLabel
+
+// VariableLabelsFromConstrained extracts just the label names from ConstrainedLabels.
+func VariableLabelsFromConstrained(cl ConstrainedLabels) []string {
+	names := make([]string, len(cl))
+	for i, c := range cl {
+		names[i] = c.Name
+	}
+	return names
+}
