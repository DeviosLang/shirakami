{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GoldenExpectedResult",
  "description": "Schema for expected.json files in golden test cases",
  "type": "object",
  "required": ["changed_functions", "call_chain", "entry_points", "cross_repo_calls"],
  "additionalProperties": false,
  "properties": {
    "changed_functions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "repo", "file"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Qualified function/method name (e.g. 'Context.JSON' or 'handleSingleStream')"
          },
          "repo": {
            "type": "string",
            "minLength": 1,
            "description": "Short repository name (e.g. 'gin', 'grpc-go')"
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "description": "Relative file path within the repository (e.g. 'context.go')"
          },
          "start_line": {
            "type": "integer",
            "minimum": 0,
            "description": "1-based line number of the function declaration"
          }
        }
      }
    },
    "call_chain": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "type"],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "description": "Caller function name"
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "description": "Callee function name"
          },
          "type": {
            "type": "string",
            "enum": ["CALLS", "IMPORTS", "EXTENDS", "IMPLEMENTS"],
            "description": "Edge type in the call graph"
          },
          "depth": {
            "type": "integer",
            "minimum": 0,
            "description": "Depth from the root changed function (0 = direct)"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Confidence score (optional, used for LLM-inferred edges)"
          }
        }
      }
    },
    "entry_points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["function", "protocol"],
        "additionalProperties": false,
        "properties": {
          "function": {
            "type": "string",
            "minLength": 1,
            "description": "Handler/entry function name"
          },
          "repo": {
            "type": "string",
            "description": "Repository containing the entry point"
          },
          "file": {
            "type": "string",
            "description": "Relative file path of the entry point"
          },
          "protocol": {
            "type": "string",
            "enum": ["HTTP", "gRPC", "MQ", "Cron", "CLI", "JSON-RPC"],
            "description": "Protocol/trigger type for this entry point"
          }
        }
      }
    },
    "cross_repo_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from_repo", "to_repo", "function"],
        "additionalProperties": false,
        "properties": {
          "from_repo": {
            "type": "string",
            "minLength": 1,
            "description": "Source repository short name"
          },
          "to_repo": {
            "type": "string",
            "minLength": 1,
            "description": "Destination repository short name"
          },
          "function": {
            "type": "string",
            "minLength": 1,
            "description": "Called remote function name"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Confidence score for the cross-repo call detection"
          }
        }
      }
    }
  }
}
